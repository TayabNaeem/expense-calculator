rules_version = '2';

// Paste these into: Firebase console -> Firestore Database -> Rules -> Publish
//
// Each signed-in account can only touch documents under its own uid. The
// default deny-all rules block the app entirely; open rules (`if true`)
// would let anyone read or delete your expenses, since this repo is public
// and the project id is visible in firebase.js.

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;

      // the profile picture is stored inline as a data URL, so cap it —
      // a Firestore document cannot exceed 1MB in total
      allow write: if request.auth != null
        && request.auth.uid == userId
        && (!('photo' in request.resource.data)
            || request.resource.data.photo.size() < 300000)
        && (!('displayName' in request.resource.data)
            || request.resource.data.displayName.size() <= 60);

      match /expenses/{expenseId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;

        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0
          && request.resource.data.date is string
          && request.resource.data.date.size() == 10
          && request.resource.data.category is string
          && request.resource.data.category.size() <= 40
          && (!('note' in request.resource.data)
              || request.resource.data.note.size() <= 200);
      }
    }

    // anything not matched above stays denied
  }
}
